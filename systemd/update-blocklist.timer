# SPDX-License-Identifier: GPL-2.0-or-later
[Unit]
Description=Assemble IP blocklists every hour

[Timer]
# after the downloads (at :20 plus up to 20 min, abuseipdb at :10); also drops
# lists that are no longer updated. Without changes, nothing is published.
OnCalendar=*-*-* *:50:00
AccuracySec=5min

[Install]
WantedBy=timers.target
