[Unit]
Description=Download IP blocklist %i
Documentation=file:/etc/blocklists/blocklists.conf
Wants=network-online.target
After=network-online.target
# update-blocklist.timer assembles the downloaded lists every hour. No
# OnSuccess= here: when two downloads finish together, systemd logs
# "multiple trigger source candidates for exit status propagation".

[Service]
Type=oneshot
User=wwwrun
Group=www
ExecStart=/usr/local/sbin/blocklist fetch %i
SyslogIdentifier=blocklist-%i
TimeoutStartSec=5min
UMask=0022
# no Restart=: failed downloads are retried by the next timer run, which also
# keeps AbuseIPDB's 5 downloads per day from being used up by retries

ProtectSystem=strict
ReadWritePaths=/var/spool/blocklists
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
